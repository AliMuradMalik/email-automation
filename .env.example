# `python run.py` creates a real .env from this file on first start and fills in
# ADMIN_PASSWORD and SECRET_KEY with random values.

# Password for logging in to the dashboard.
ADMIN_PASSWORD=

# Encrypts stored mailbox passwords and signs unsubscribe links.
# Do not change it after adding mailboxes, or saved passwords can't be decrypted.
SECRET_KEY=

# Public address of this app. Unsubscribe links in your emails point here, so
# for real campaigns it must be reachable from the internet (https://...).
PUBLIC_BASE_URL=http://localhost:8000

HOST=127.0.0.1
PORT=8000

# Background worker: sends due emails and checks inboxes for replies/bounces.
WORKER_ENABLED=true
SEND_TICK_SECONDS=30
INBOX_TICK_SECONDS=300

# Leave empty to use data/outreach.db (SQLite).
DATABASE_URL=
    
# Secret for the /tasks/tick URL that an outside timer calls when the app is hosted
# online (Vercel). Leave empty to disable that endpoint.
CRON_SECRET=
